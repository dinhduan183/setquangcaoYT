{
  "manifest_version": 3,
  "name": "YT Ad Breaks từ Tracklist",
  "version": "1.0.0",
  "description": "Chèn vị trí quảng cáo giữa video YouTube Studio theo timestamp trong tracklist.",
  "permissions": ["storage", "activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Chèn quảng cáo theo tracklist",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://studio.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
